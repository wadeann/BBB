[Unit]
Description=A-Share Agent Background Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=a-share
Group=a-share
WorkingDirectory=/opt/a-share-agent
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
ExecStart=/opt/a-share-agent/.venv/bin/a-share-agent --root /opt/a-share-agent --backend production worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/a-share-agent/data

[Install]
WantedBy=multi-user.target
