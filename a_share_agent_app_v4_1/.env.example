# A股 Agent project-local environment configuration.
# Fill values on the deployment host. This file is auto-loaded by the application.
# Existing process environment variables take precedence over values here.
# Keep chmod 600. Do NOT commit or share a filled copy.

# MCP Basic Auth
ASHARE_MCP_USERNAME=
ASHARE_MCP_PASSWORD=

# OpenAI-compatible LLM
ASHARE_LLM_BASE_URL=
ASHARE_LLM_API_KEY=
ASHARE_LLM_MODEL=

# Optional Jin10 MCP
# ASHARE_JIN10_MCP_URL=
# ASHARE_JIN10_MCP_TOKEN=

# Optional Feishu notification
ASHARE_FEISHU_WEBHOOK_URL=
ASHARE_FEISHU_SECRET=
