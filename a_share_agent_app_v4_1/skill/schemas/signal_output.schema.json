{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-share Signal Output",
  "type": "object",
  "required": [
    "symbol",
    "as_of",
    "mode",
    "decision",
    "score",
    "triggered_signals",
    "reasons_against",
    "human_confirmation_required"
  ],
  "properties": {
    "symbol": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "research",
        "backtest",
        "paper",
        "live_proposal"
      ]
    },
    "decision": {
      "enum": [
        "REJECT",
        "WATCH",
        "ENTRY_CANDIDATE",
        "EXIT_CANDIDATE",
        "ORDER_PROPOSAL"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "score_breakdown": {
      "type": "object"
    },
    "triggered_signals": {
      "type": "array"
    },
    "reasons_against": {
      "type": "array",
      "minItems": 1
    },
    "entry_zone": {
      "type": [
        "object",
        "null"
      ]
    },
    "invalidation": {
      "type": [
        "string",
        "null"
      ]
    },
    "stop": {
      "type": [
        "number",
        "null"
      ]
    },
    "position_cap": {
      "type": [
        "number",
        "null"
      ]
    },
    "data_quality": {
      "type": "object"
    },
    "rule_checks": {
      "type": "object"
    },
    "fill_assumption": {
      "type": "string"
    },
    "human_confirmation_required": {
      "type": "boolean"
    },
    "market_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "sector_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "risk_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "tool_trace": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "intent_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
